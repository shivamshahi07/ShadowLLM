{
  "name": "shadow-llm-proxy",
  "version": "1.0.0",
  "type": "module",
  "description": "Production AI Shadow-Testing & Live Drift Engine with Zero-Latency Bifurcation & Side-Effect Virtualization",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "node apps/server/dist/index.js",
    "worker": "node apps/worker/dist/index.js",
    "dev:server": "npm run dev --workspace=@shadow-llm/server",
    "dev:dashboard": "npm run dev --workspace=@shadow-llm/dashboard",
    "dev:worker": "npm run dev --workspace=@shadow-llm/worker",
    "seed": "npm run seed --workspace=@shadow-llm/shared",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
