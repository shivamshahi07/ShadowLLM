# ==============================================================================
# ShadowLLM Environment Configuration (.env.example)
# All services support 100% offline mock fallbacks for zero-credential local dev.
# ==============================================================================

# Server & Networking
PORT=8080
HOST=0.0.0.0
# Optional Bearer token for client apps calling the proxy (leave blank to disable auth)
PROXY_AUTH_TOKEN=

# Database (Neon Serverless PostgreSQL)
# Free Tier: Neon (0.5GB free, https://neon.tech)
# Fallback: Leave empty for zero-dependency offline persistent storage
DATABASE_URL=

# Stream Buffer / Queue (Upstash Redis)
# Free Tier: Upstash Redis (10,000 commands/day free, https://upstash.com)
# Fallback: Leave empty to use built-in zero-latency in-memory stream buffer
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# Primary Production Model (Baseline Target)
# Providers: 'openai' (OpenAI), 'gemini' (Google AI Studio), or 'mock' (offline)
# Free Tier: Google AI Studio (15 RPM free, https://aistudio.google.com)
# Fallback: When PRIMARY_API_KEY is empty, server automatically uses internal deterministic mock
PRIMARY_PROVIDER=mock
PRIMARY_API_KEY=
PRIMARY_BASE_URL=https://api.openai.com/v1
PRIMARY_MODEL=gpt-4o

# Shadow Experimental Model (Canary Target)
# Providers: 'groq' (GroqCloud), 'gemini' (Google AI Studio), or 'mock' (offline)
# Free Tier: Groq (30 RPM free, https://console.groq.com)
# Fallback: When SHADOW_API_KEY is empty, worker automatically uses internal deterministic mock
SHADOW_PROVIDER=mock
SHADOW_API_KEY=
SHADOW_BASE_URL=https://api.groq.com/openai/v1
SHADOW_MODEL=llama-3.3-70b-versatile

# Semantic Drift & Embedding Engine
# Providers: 'gemini' (text-embedding-004), 'openai' (text-embedding-3-small), or 'mock'
# Free Tier: Google AI Studio (1,500 RPD free)
# Fallback: Built-in deterministic n-gram vectorizer producing exact cosine similarity offline
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004

# Canary Dynamic Configuration Defaults
CANARY_SAMPLE_RATE=0.50
DRIFT_THRESHOLD=0.85
RUN_EMBEDDED_WORKER=true

# Dashboard (Next.js 15)
NEXT_PUBLIC_PROXY_API_URL=http://localhost:8080
